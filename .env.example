# Sign-in/signing (Privy). Configure allowed app origins and Ethereum wallets in
# the Privy dashboard. See docs/purchase-experience.md. App/client IDs are public;
# the secret verifies bearer tokens and wallet ownership on the server.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# Persistence (Supabase). Only the service role is used, on the server.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model provider (OpenRouter) and the tool-calling model for the trading agent.
OPENROUTER_API_KEY=
SOCIALTRADING_MODEL=openai/gpt-4.1-mini
# Credits: every model call is charged at the cost OpenRouter reports (`usage.cost`). When a provider omits cost,
# the call is charged at this USD price per million tokens instead and flagged `estimate` in the ledger.
SOCIALTRADING_FALLBACK_USD_PER_MTOKEN=1

# Robinhood Agentic Trading (per-user OAuth tokens are stored encrypted; never put a user token here)
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# MCP tool used to place orders once a user has connected Robinhood.
ROBINHOOD_ORDER_TOOL=place_order
# Registered application callback origin; never derive this from request headers.
SOCIALTRADING_APP_URL=http://localhost:3001
# 32 random bytes encoded as 64 hexadecimal characters; encrypts per-user OAuth tokens.
SOCIALTRADING_ENCRYPTION_KEY=

# Stock / market data
MASSIVE_API_KEY=

# Crypto data (CoinGecko Demo API)
COINGECKO_API_KEY=

# Crypto execution (server only). Uniswap V2/V3 exact-input swaps.
UNISWAP_API_KEY=
# demo (default, optional key) or pro (requires a Pro key)
COINGECKO_API_PLAN=demo
# Server-only HTTPS JSON-RPC endpoints for each supported purchase chain.
# Required methods: eth_chainId, eth_call, eth_getBalance, eth_estimateGas,
# eth_gasPrice, eth_getTransactionCount, eth_getTransactionByHash,
# eth_getTransactionReceipt, eth_getBlockByNumber, eth_blockNumber.
# Base/Optimism also require eth_call to the gas oracle for L1/operator fees.
# Wrong-chain, unavailable, or missing RPC configuration blocks execution.
# New purchases pay native gas (ETH, or POL on Polygon); sponsorship is not enabled.
CRYPTO_RPC_URL_1=
CRYPTO_RPC_URL_8453=
CRYPTO_RPC_URL_42161=
CRYPTO_RPC_URL_10=
CRYPTO_RPC_URL_137=

# Legacy only: receipt recovery for purchases already issued as ERC-4337 operations.
# New purchases use the selected Privy provider, not a bundler or USDC paymaster.
# Retain the previous URL to recover old operations; {chainId} is supported.
# A NEXT_PUBLIC URL is public: never put a private credential here.
NEXT_PUBLIC_BUNDLER_URL=
# DexScreener and the public DefiLlama endpoints require no keys.

# Scheduled agent runs (Vercel Cron, every 30 minutes; see vercel.json). Vercel sends this value as
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/agents. Generate 32+ random bytes; runs stay disabled until set.
CRON_SECRET=
